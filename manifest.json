{
  "manifest_version": 3,
  "name": "AI Chat Exporter - Free, Private, OpenSource",
  "version": "1.7.0",
  "description": "Export AI chats from ChatGPT, Claude, Gemini & more to Markdown or JSON.",
  "homepage_url": "https://ai-chat-exporter.covai.org/",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "host_permissions": [
    "*://chatgpt.com/*",
    "*://gemini.google.com/*",
    "*://claude.ai/*",
    "*://qwen.ai/*",
    "*://chat.qwen.ai/*",
    "*://www.perplexity.ai/*",
    "*://chat.deepseek.com/*",
    "*://www.meta.ai/*",
    "*://meta.ai/*",
    "*://chat.mistral.ai/*",
    "*://chat.z.ai/*",
    "*://console.cloud.google.com/*",
    "*://aistudio.google.com/*",
    "*://notebooklm.google.com/*",
    "*://copilot.microsoft.com/*",
    "*://www.copilot.microsoft.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://gemini.google.com/*",
        "*://claude.ai/*",
        "*://qwen.ai/*",
        "*://chat.qwen.ai/*",
        "*://www.perplexity.ai/*",
        "*://chat.deepseek.com/*",
        "*://www.meta.ai/*",
        "*://meta.ai/*",
        "*://chat.mistral.ai/*",
        "*://chat.z.ai/*",
        "*://console.cloud.google.com/*",
        "*://aistudio.google.com/*",
        "*://notebooklm.google.com/*",
        "*://copilot.microsoft.com/*",
        "*://www.copilot.microsoft.com/*",
        "*://*.google.com/*",
        "*://*.google.com/search*",
        "*://*.google.co.in/search*",
        "*://*.google.co.uk/search*",
        "*://*.google.ca/search*",
        "*://*.google.com.au/search*",
        "*://*.google.de/search*",
        "*://*.google.fr/search*"
      ],
      "js": ["content/main.js"],
      "run_at": "document_idle",
      "type": "module"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/main.js",
        "content/loader.js",
        "content/claude_react_reader.js",
        "content/chatgpt_helper.js",
        "content/lib/*.js",
        "content/utils/*.js",
        "content/parsers/*.js",
        "content/formatters/*.js",
        "schemas/*.json"
      ],
      "matches": [
        "*://chatgpt.com/*",
        "*://gemini.google.com/*",
        "*://claude.ai/*",
        "*://qwen.ai/*",
        "*://chat.qwen.ai/*",
        "*://www.perplexity.ai/*",
        "*://chat.deepseek.com/*",
        "*://www.meta.ai/*",
        "*://meta.ai/*",
        "*://chat.mistral.ai/*",
        "*://chat.z.ai/*",
        "*://console.cloud.google.com/*",
        "*://copilot.microsoft.com/*",
        "*://www.copilot.microsoft.com/*",
        "*://*.google.com/*",
        "*://*.google.co.in/*",
        "*://*.google.co.uk/*",
        "*://*.google.ca/*",
        "*://*.google.com.au/*",
        "*://*.google.de/*",
        "*://*.google.fr/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
